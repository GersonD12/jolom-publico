    "firebase-functions": "^7.1.0",
    "ngeohash": "^0.6.3"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-tools": "^15.24.0"
  },
  "private": true
}
